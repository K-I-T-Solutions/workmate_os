{
  "name": "Verträge – tägliche Abrechnung & Ablaufwarnungen (v5.0)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "cron-daily",
      "name": "Täglich 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.workmate.kit-it-koblenz.de/api/backoffice/contracts/jobs/billing",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "run-billing",
      "name": "Fällige Verträge abrechnen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "workmate-contracts-key",
          "name": "WorkmateOS API-Key (contracts:billing, assets:read)"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.workmate.kit-it-koblenz.de/api/backoffice/assets/jobs/expiring",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "within_days",
              "value": "30"
            }
          ]
        },
        "options": {}
      },
      "id": "get-expiring",
      "name": "Ablaufende Garantien/Lizenzen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "workmate-contracts-key",
          "name": "WorkmateOS API-Key (contracts:billing, assets:read)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const billing = $('Fällige Verträge abrechnen').first().json;\nconst expiring = $('Ablaufende Garantien/Lizenzen').first().json.items || [];\nconst fmt = d => new Date(d).toLocaleDateString('de-DE');\nconst lines = [];\nif (billing.invoices_created.length) {\n  lines.push(`${billing.invoices_created.length} Rechnungsentwürfe erstellt – bitte prüfen und versenden:`);\n  for (const i of billing.invoices_created) lines.push(`  • ${i.invoice_number} (${i.contract_number}, ${fmt(i.period_start)}–${fmt(i.period_end)}): ${i.total} €`);\n}\nif (billing.contracts_renewed.length) lines.push(`Automatisch verlängert: ${billing.contracts_renewed.join(', ')}`);\nif (billing.contracts_expired.length) lines.push(`Ausgelaufen: ${billing.contracts_expired.join(', ')}`);\nif (billing.errors.length) { lines.push('FEHLER:'); for (const e of billing.errors) lines.push(`  • ${e.contract_number}: ${e.error}`); }\nif (billing.notice_deadlines.length) { lines.push('Kündigungsfristen in den nächsten 30 Tagen:'); for (const n of billing.notice_deadlines) lines.push(`  • ${n.contract_number} ${n.title} (${n.customer_name}) – Frist ${fmt(n.notice_deadline)}${n.auto_renew ? ', verlängert sich sonst automatisch' : ''}`); }\nif (expiring.length) { lines.push('Läuft in 30 Tagen ab:'); for (const x of expiring) lines.push(`  • ${x.kind === 'warranty' ? 'Garantie' : 'Lizenz'}: ${x.name} (${x.customer_name}) am ${fmt(x.expires_on)}`); }\nreturn [{ json: { has_news: lines.length > 0, text: lines.join('\\n') } }];"
      },
      "id": "summary",
      "name": "Zusammenfassung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.has_news }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-news",
      "name": "Etwas zu melden?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "noreply@kit-it-koblenz.de",
        "toEmail": "buchhaltung@kit-it-koblenz.de",
        "subject": "=WorkmateOS: Vertragsabrechnung {{ new Date().toLocaleDateString('de-DE') }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "mail",
      "name": "Info-Mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1340,
        280
      ],
      "credentials": {
        "smtp": {
          "id": "smtp-kit",
          "name": "K.I.T. SMTP"
        }
      }
    }
  ],
  "connections": {
    "Täglich 06:00": {
      "main": [
        [
          {
            "node": "Fällige Verträge abrechnen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fällige Verträge abrechnen": {
      "main": [
        [
          {
            "node": "Ablaufende Garantien/Lizenzen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ablaufende Garantien/Lizenzen": {
      "main": [
        [
          {
            "node": "Zusammenfassung",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Zusammenfassung": {
      "main": [
        [
          {
            "node": "Etwas zu melden?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Etwas zu melden?": {
      "main": [
        [
          {
            "node": "Info-Mail",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Berlin"
  },
  "meta": {
    "description": "Benötigt API-Key mit Scopes contracts:billing,assets:read: POST /api/v1/email/admin/keys?name=n8n-contracts&scopes=contracts:billing,assets:read. Header-Auth: Name 'Authorization', Wert 'Bearer <key>'. Empfänger-Adresse vor Aktivierung prüfen."
  }
}