        "options": {}
      },
      "id": "run-billing",
      "name": "Fällige Verträge abrechnen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wmContracts5Key01",
          "name": "WorkmateOS API-Key (contracts:billing, assets:read)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.workmate.kit-it-koblenz.de/api/backoffice/assets/jobs/expiring",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "within_days",
              "value": "30"
            }
          ]
        },
        "options": {}
      },
      "id": "get-expiring",
      "name": "Ablaufende Garantien/Lizenzen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wmContracts5Key01",
          "name": "WorkmateOS API-Key (contracts:billing, assets:read)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const billing = $('Fällige Verträge abrechnen').first().json;\nconst expiring = $('Ablaufende Garantien/Lizenzen').first().json.items || [];\nconst fmt = d => new Date(d).toLocaleDateString('de-DE');\nconst lines = [];\nconst eur = v => Number(v).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });\nif (billing.invoices_created.length) {\n  lines.push(`**🧾 ${billing.invoices_created.length} Rechnungsentwürfe erstellt** – bitte prüfen und versenden:`);\n  for (const i of billing.invoices_created) lines.push(`  • ${i.invoice_number} (${i.contract_number}, ${fmt(i.period_start)}–${fmt(i.period_end)}): ${eur(i.total)}`);\n}\nif (billing.contracts_renewed.length) lines.push(`Automatisch verlängert: ${billing.contracts_renewed.join(', ')}`);\nif (billing.contracts_expired.length) lines.push(`Ausgelaufen: ${billing.contracts_expired.join(', ')}`);\nif (billing.errors.length) { lines.push('**⚠️ Fehler:**'); for (const e of billing.errors) lines.push(`  • ${e.contract_number}: ${e.error}`); }\nif (billing.notice_deadlines.length) { lines.push('**📅 Kündigungsfristen in den nächsten 30 Tagen:**'); for (const n of billing.notice_deadlines) lines.push(`  • ${n.contract_number} ${n.title} (${n.customer_name}) – Frist ${fmt(n.notice_deadline)}${n.auto_renew ? ', verlängert sich sonst automatisch' : ''}`); }\nif (expiring.length) { lines.push('**⏳ Läuft in 30 Tagen ab:**'); for (const x of expiring) lines.push(`  • ${x.kind === 'warranty' ? 'Garantie' : 'Lizenz'}: ${x.name} (${x.customer_name}) am ${fmt(x.expires_on)}`); }\nlet text = `## WorkmateOS – Verträge ${new Date().toLocaleDateString('de-DE')}\\n` + lines.join('\\n');\nif (text.length > 1900) text = text.slice(0, 1900) + '\\n… (gekürzt, Details in WorkmateOS)';\nreturn [{ json: { has_news: lines.length > 0, text } }];"
      },
      "id": "summary",
      "name": "Zusammenfassung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.has_news }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-news",
      "name": "Etwas zu melden?",
